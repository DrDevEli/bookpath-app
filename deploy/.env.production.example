# BookPath production environment — copy to /opt/bookpath/backend/.env and fill in.
# Generate secrets with:  openssl rand -hex 32

NODE_ENV=production
PORT=3001

# --- Required (no default — boot fails without these) ---
MONGODB_URI=mongodb://127.0.0.1:27017/bookpath
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
SESSION_SECRET=CHANGE_ME

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- SEO / canonical URLs ---
SITE_URL=https://bookpath.org

# --- Revenue / features ---
AMAZON_ASSOCIATES_TAG=bookpath0a-20
AMAZON_DOMAIN=amazon.de
GOOGLE_BOOKS_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME

# --- Behind nginx: trust the proxy so req.ip / rate limiting see real IPs ---
TRUST_PROXY=true

# --- Optional: email (SMTP). Uncomment + fill to enable real email
# (password reset / verification / weekly deals). Left absent, emailService
# fake-logs instead of sending.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=CHANGE_ME
# SMTP_PASS=CHANGE_ME
# EMAIL_FROM="BookPath <no-reply@bookpath.eu>"
